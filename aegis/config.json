{
  "vaultPath": "../Memecoin/Crypto finder",
  "notesFolder": "Signals",
  "chains": ["solana", "base", "ethereum", "bsc"],

  "rpcUrl": "https://api.mainnet-beta.solana.com",

  "filters": {
    "minLiquidityUsd": 4000,
    "minMarketCapUsd": 12000,
    "maxMarketCapUsd": 8000000,
    "maxAgeHours": 96,
    "minTxns24h": 40
  },

  "thresholds": {
    "buySignalDemandRatio": 2.0,
    "crashSellRatio": 3.0,
    "minLiqToMcapPct": 15,
    "maxTop10Pct": 25,
    "maxTop10PctYoung": 20,
    "youngTokenHours": 2,
    "minLpLockedPct": 99,
    "maxTotalTaxPct": 5,
    "buySignalScore": 80,
    "watchScore": 55,
    "minUniqueHolders": 150,
    "lowHolderScoreCap": 45
  },

  "social": {
    "bonusBothSocials": 10,
    "bonusOneSocial": 5
  },

  "_signalCategoryNote": [
    "Two holding styles. GEM requires every condition positively proven —",
    "an unknown age or holder count disqualifies it — because its advice is to",
    "hold for days/weeks. SCALP tolerates an unproven age since 'take profit",
    "quickly' stays sound either way.",
    "",
    "Measured from 453 post-mortem outcomes as of 2026-08-05:",
    "  $15k-300k (the SCALP band) failed 40% of the time (154/389),",
    "  median time to failure 1.86h. $300k-1M failed 3% (1/29).",
    "  Nothing has ever been scanned at >=$1M, so GEM will not fire until",
    "  discovery surfaces larger tokens. Raise filters.maxMarketCapUsd and",
    "  widen discovery if you want that tier to populate."
  ],
  "signalCategories": {
    "gem": {
      "minMarketCapUsd": 1000000,
      "minLiquidityUsd": 100000,
      "minAgeHours": 24,
      "minHolders": 1000,
      "scoreBoost": 10,
      "advice": "💎 Long-term accumulation setup — suitable for holding over days/weeks."
    },
    "scalp": {
      "minMarketCapUsd": 15000,
      "maxMarketCapUsd": 300000,
      "maxAgeHours": 24,
      "advice": "⚡ Fast momentum trade — take initial profit at +50% to +100%!"
    }
  },

  "postMortem": {
    "enabled": true,
    "minAgeHours": 1,
    "maxAgeHours": 6,
    "rugDropPct": 80,
    "rugMcapFloorUsd": 5000,
    "winGainPct": 100
  },

  "deployer": {
    "enabled": true,
    "deployerScanSignatures": 40,
    "deployerMaxTxLookups": 18,
    "deployerCacheHours": 12,
    "deployerMatureMinutes": 30,
    "deployerDeadLiquidityUsd": 1000,
    "deployerSuccessMcapUsd": 100000,
    "deployerSerialMinDeploys": 3,
    "deployerDeadRatio": 0.7,
    "deployerGoodMinSuccesses": 2,
    "deployerBurstMinMints": 4,
    "deployerBurstWindowSec": 600,
    "rpcDelayMs": 220
  },

  "smartMoney": {
    "enabled": true,
    "watchlistFile": "smart_wallets.json",
    "earlyAccumulationMinutes": 10,
    "scoreBonus": 15,
    "scanRecentBuyers": true,
    "buyerScanSignatures": 60,
    "buyerMaxTxLookups": 25,
    "buyerRetries": 2,
    "rpcBackoffMs": 700,
    "rpcDelayMs": 220
  },

  "telegram": {
    "enabled": true,
    "minScore": 80,
    "cooldownHours": 6,
    "sendScanDigest": true,
    "requireLiveReaudit": false
  },

  "writeNotes": true,

  "tradeLinkTemplate": "https://fomo.family/tokens/{chain}/{address}",
  "tradeLinkLabel": "Trade on FOMO App",

  "requestDelayMs": 350,
  "maxTokensPerScan": 40
}
