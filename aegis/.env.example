# Copy this file to `.env` in the same directory and fill in your values.
# `.env` holds secrets — do not commit it or share it.

# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#    It replies with a token that looks like 123456789:AAF...
TELEGRAM_BOT_TOKEN=

# 2. Send any message to your new bot, then open:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    Your chat id is result[0].message.chat.id (a number, possibly negative
#    for groups).
TELEGRAM_CHAT_ID=

# Optional: a dedicated Solana RPC endpoint. The public one is heavily rate
# limited, which caps how deep the deployer and buyer scans can go.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ── Channel listener (telegram_listener.mjs) — optional ────────────────
# Only needed if you want Aegis to read signal/trending channels.
#
# A BOT CANNOT DO THIS. Telegram does not deliver channel messages to bots that
# do not administer the channel, so the token above is not enough. Reading
# channels you merely subscribe to requires MTProto with YOUR user account.
#
# 3. Create an app at https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 4. Then run, in a terminal, yourself:
#      node aegis/telegram_listener.mjs --login
#    It asks for your phone number, the SMS code and your 2FA password, and
#    prints a session string to paste below.
#
#    ⚠️  TELEGRAM_SESSION IS AS POWERFUL AS YOUR PASSWORD. Anyone holding it can
#    read your DMs and send messages as you. Never paste it into a chat, an
#    issue, a screenshot, or an AI assistant — including the one that wrote
#    this file. Revoke it from Telegram → Settings → Devices.
TELEGRAM_SESSION=

# ── News & social catalyst suite — all optional ────────────────────────
# Everything below is OPTIONAL. Measured behaviour without them:
#   news_sentinel  works on 4 open RSS feeds (CoinDesk, Cointelegraph,
#                  Decrypt, The Block). CryptoPanic is 403 without a token.
#   social_tracer  works on CoinGecko's keyless tier, but ~40% of contract
#                  lookups get rate-limited, so trending Solana tokens can
#                  be missed. A FREE demo key fixes that.

# CryptoPanic — adds a fifth news source. https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=

# CoinGecko demo key (free): https://www.coingecko.com/en/developers/dashboard
# Strongly recommended — without it the trending match set has gaps.
COINGECKO_API_KEY=

# Twitter/X bearer token. PAID: the v2 search endpoints answer 401 on the free
# tier. Without this, mention velocity is simply not part of the signal.
TWITTER_BEARER_TOKEN=

# Google Gemini key, for AI meme-narrative scoring (ai_narrative_scorer.mjs).
# Optional: without it the scorer is inert and the +15 narrative bonus is never
# awarded — never a penalty, and the rest of the audit is unaffected.
#
# One call per mint, ever: results cache to .state/ai_narrative_cache.json and a
# token's name does not change. Calls are skipped for tokens whose audit did not
# PASS, since the bonus would be forfeited anyway.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
